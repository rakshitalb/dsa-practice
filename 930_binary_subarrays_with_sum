class Solution:
    def numSubarraysWithSum(self, nums: list[int], goal: int) -> int:
        prefix_sum = 0
        count = 0
        prefix_count = {0: 1}

        for num in nums:
            prefix_sum += num

            needed = prefix_sum - goal
            count += prefix_count.get(needed, 0)

            prefix_count[prefix_sum] = (
                prefix_count.get(prefix_sum, 0) + 1
            )

        return count
