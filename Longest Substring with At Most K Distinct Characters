def longest_substring_with_at_most_k_distinct_characters(s: str, k: int) -> int:
    count = {}
    res = 0
    l = 0

    for r in range(len(s)):
        # Add the current character
        count[s[r]] = count.get(s[r], 0) + 1

        # Shrink the window if it has more than k distinct characters
        while len(count) > k:
            count[s[l]] -= 1

            if count[s[l]] == 0:
                del count[s[l]]

            l += 1

        # Update the maximum window length
        res = max(res, r - l + 1)

    return res


if __name__ == "__main__":
    s = input()
    k = int(input())

    res = longest_substring_with_at_most_k_distinct_characters(s, k)
    print(res)
