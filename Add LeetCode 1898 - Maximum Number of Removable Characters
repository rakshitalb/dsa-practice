
class Solution:
    def maximumRemovals(
        self, s: str, p: str, removable: list[int]
    ) -> int:
        left = 0
        right = len(removable)

        while left < right:
            mid = left + (right - left + 1) // 2

            removed = set(removable[:mid])
            j = 0

            for i in range(len(s)):
                if i not in removed and j < len(p) and s[i] == p[j]:
                    j += 1

            if j == len(p):
                left = mid
            else:
                right = mid - 1

        return left
