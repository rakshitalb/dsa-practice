class Solution:
    def findAnagrams(self, s: str, p: str) -> list[int]:
        need = {}

        for ch in p:
            need[ch] = need.get(ch, 0) + 1

        l = 0
        window = {}
        ans = []

        for r in range(len(s)):
            ch = s[r]
            window[ch] = window.get(ch, 0) + 1

            if r - l + 1 > len(p):
                lch = s[l]
                window[lch] -= 1

                if window[lch] == 0:
                    del window[lch]

                l += 1

            if window == need:
                ans.append(l)

        return ans
