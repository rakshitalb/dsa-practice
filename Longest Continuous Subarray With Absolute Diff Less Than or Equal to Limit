
class Solution:
    def longestSubarray(self, nums: list[int], limit: int) -> int:
        l = 0
        m = 0

        for r in range(len(nums)):
            d = max(nums[l:r + 1]) - min(nums[l:r + 1])

            while d > limit:
                l += 1
                d = max(nums[l:r + 1]) - min(nums[l:r + 1])

            m = max(m, r - l + 1)

        return m
