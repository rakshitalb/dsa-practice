class Solution:
    def checkInclusion(self, s1: str, s2: str) -> bool:
        need = {}

        # Count characters in s1
        for ch in s1:
            need[ch] = need.get(ch, 0) + 1

        window = {}
        left = 0

        for right in range(len(s2)):

            # Add right character
            ch = s2[right]
            window[ch] = window.get(ch, 0) + 1

            # Keep window size equal to len(s1)
            if right - left + 1 > len(s1):
                left_ch = s2[left]
                window[left_ch] -= 1

                if window[left_ch] == 0:
                    del window[left_ch]

                left += 1

            # Check whether current window is a permutation of s1
            if window == need:
                return True

        return False
