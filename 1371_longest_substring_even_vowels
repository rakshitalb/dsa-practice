class Solution:
    def findTheLongestSubstring(self, s: str) -> int:
        vowels = {'a': 1, 'e': 2, 'i': 4, 'o': 8, 'u': 16}
        state = 0
        first_seen = {0: -1}
        max_length = 0

        for i, ch in enumerate(s):
            if ch in vowels:
                state ^= vowels[ch]

            if state in first_seen:
                max_length = max(max_length, i - first_seen[state])
            else:
                first_seen[state] = i

        return max_length
